{
  "name": "vidolib-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VidoLib - High-performance, zero-copy, worker-first web media runtime monorepo",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:umd": "node scripts/build-umd.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && node scripts/check-licensing.js",
    "check-licensing": "node scripts/check-licensing.js",
    "size-limit": "node scripts/size-limit.js",
    "benchmark": "vitest run benchmarks/perf.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-app-manifest": "^1.0.8",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
